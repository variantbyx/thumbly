# Server configuration
PORT=3000
NODE_ENV=development

# Frontend client URL (CORS allowed origin)
# In production, set to your frontend domain (e.g. https://thumbly-client.vercel.app)
CLIENT_URL=http://localhost:5173

# Database (MongoDB connection string or MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/thumbly

# Session Secret (Generate a strong random string for production)
SESSION_SECRET=your_long_random_session_secret_here

# Cloudinary configuration (Required for production image persistence)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Gemini API configuration
GEMINI_API_KEY=your_gemini_api_key
